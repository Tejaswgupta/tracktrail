import argparse
import json
import os
import random
import re

import pandas as pd
from dotenv import load_dotenv
from langchain.agents import AgentExecutor, create_tool_calling_agent
from langchain_core.prompts import ChatPromptTemplate
from langchain_experimental.tools import PythonREPLTool
from langchain_openai import ChatOpenAI

load_dotenv()

# --- Configuration ---
# Set your OpenAI API key as an environment variable named OPENAI_API_KEY
# You can do this in your terminal like this:
# export OPENAI_API_KEY='your_api_key'

AGENT_PROMPT_TEMPLATE = """
You are a regex generation expert with Python code execution capabilities. Your task is to create GENERIC regex patterns that extract beneficiary names from bank transaction descriptions.

ALL UNIQUE TRANSACTION DESCRIPTIONS (test against these):
{all_descriptions}

CRITICAL RULES - READ CAREFULLY:
1. Create GENERIC patterns based on STRUCTURE, not specific names/values
2. DO NOT hardcode specific beneficiary names (e.g., "JOHN SMITH", "ACME CORP")
3. DO NOT hardcode specific account numbers or reference IDs
4. Focus on the FORMAT and DELIMITERS used by the bank (NEFT/RTGS/IMPS/UPI/etc.)
5. Patterns must work for ANY beneficiary name with the same transaction format

Example - WRONG (too specific):
- "^NEFT.*?-JOHN SMITH-.*"  ❌ (hardcoded name)
- "^RTGS.*?ACC12345.*"       ❌ (hardcoded account)

Example - CORRECT (generic):
- "^NEFT.*?-([A-Z\\s]+)-.*"        ✅ (matches any name with same format)
- "^RTGS.*?/([A-Z0-9\\s]+)/.*"     ✅ (matches any name/account with same delimiters)
- "^IMPS-P2A-\\d+-([A-Z\\s]+)-.*"  ✅ (generic pattern for IMPS P2A format)

YOUR ITERATIVE APPROACH:
1. Use python_repl to analyze STRUCTURE of transaction descriptions
2. Identify common DELIMITERS (-, /, :, etc.) and PREFIXES (NEFT, RTGS, UPI, etc.)
3. Generate initial generic patterns using character classes ([A-Z\\s]+, \\w+, etc.)
4. TEST patterns against ALL descriptions above using re.match()
5. Calculate accuracy (matched / total * 100)
6. If accuracy < 90%, analyze failed descriptions and refine patterns
7. REPEAT steps 4-6 until accuracy >= 90% or max iterations reached

Use python_repl to write code that:
- Tests patterns on all descriptions
- Tracks which descriptions fail
- Iteratively refines patterns based on failures
- Continues until 90% accuracy achieved

Return ONLY a JSON object with "patterns" key containing final generic regex array.

Final response format (no explanations, just JSON):
{{"patterns": ["regex1", "regex2", ...]}}
"""

def get_api_key():
    """Gets the OpenAI API key from environment variables."""
    api_key = os.getenv("OPENAI_API_KEY")
    if not api_key:
        raise ValueError("OpenAI API key not found. Please set the OPENAI_API_KEY environment variable.")
    return api_key

def find_unique_transactions(df, description_col, max_samples_per_type=10, num_random_samples=10):
    """Finds a diverse set of unique transaction descriptions for different payment types and adds random samples."""
    unique_descriptions = df[description_col].dropna().unique()
    payment_types = ['NEFT', 'RTGS', 'IMPS', 'UPI']
    samples = {p_type: [] for p_type in payment_types}

    # 1. Targeted Sampling
    for desc in unique_descriptions:
        if not isinstance(desc, str):
            continue
        for p_type in payment_types:
            if p_type in desc and len(samples[p_type]) < max_samples_per_type:
                samples[p_type].append(desc)
                break
    
    # Flatten the dictionary of lists into a single list
    targeted_samples = []
    for p_type in payment_types:
        targeted_samples.extend(samples[p_type])
        
    # 2. Random Sampling
    remaining_descriptions = [d for d in unique_descriptions if d not in targeted_samples]
    
    random_samples = []
    if remaining_descriptions:
        # Ensure we don't try to sample more than what is available
        num_to_sample = min(num_random_samples, len(remaining_descriptions))
        random_samples = random.sample(remaining_descriptions, num_to_sample)

    # 3. Combine samples
    final_samples = targeted_samples + random_samples
    
    return final_samples

def generate_regex_with_langchain_agent(samples):
    """Generates regex patterns using LangChain agent with Python REPL tool."""
    samples_text = "\n".join(f"- {s}" for s in samples)
    
    try:
        print("\n" + "="*80)
        print("Initializing LangChain Agent with Python Code Execution")
        print("="*80)
        print("The agent will write and execute Python code to test regex patterns...\n")
        
        # Initialize LLM
        llm = ChatOpenAI(
            model="gpt-4o",
            temperature=0.1,
            api_key=os.getenv("OPENAI_API_KEY"),
            base_url="https://model.thevotum.com/v1"
        )
        
        # Create Python REPL tool for code execution
        python_repl = PythonREPLTool()
        tools = [python_repl]
        
        # Create prompt
        prompt = ChatPromptTemplate.from_messages([
            ("system", "You are an expert regex engineer with Python code execution. Create GENERIC patterns based on structure and delimiters, NOT specific names or values. Never hardcode beneficiary names, account numbers, or IDs in patterns. Use character classes like [A-Z\\s]+, \\w+, [A-Z0-9]+ to match variable content."),
            ("human", "{input}"),
            ("placeholder", "{agent_scratchpad}"),
        ])
        
        # Create agent
        agent = create_tool_calling_agent(llm, tools, prompt)
        agent_executor = AgentExecutor(
            agent=agent,
            tools=tools,
            verbose=True,
            max_iterations=10,
            handle_parsing_errors=True
        )
        
        # Format input
        user_input = AGENT_PROMPT_TEMPLATE.format(samples=samples_text)
        
        # Run agent
        print("Agent is working...\n")
        result = agent_executor.invoke({"input": user_input})
        
        print("\n" + "="*80)
        print("Agent Execution Complete")
        print("="*80)
        
        output_text = result.get("output", "")
        print(f"\nAgent Output:\n{output_text}\n")
        
        # Extract JSON from output
        json_match = re.search(r'\{[^{}]*"patterns"[^{}]*\[.*?\][^{}]*\}', output_text, re.DOTALL)
        if json_match:
            data = json.loads(json_match.group(0))
        else:
            # Try to parse the whole output
            data = json.loads(output_text)
        
        if "patterns" in data and isinstance(data["patterns"], list):
            return data["patterns"]
        
        # Fallback
        for key in data:
            if isinstance(data[key], list):
                return data[key]
        
        raise ValueError("No regex patterns array found in agent output.")

    except json.JSONDecodeError as e:
        print(f"JSON parsing error: {e}")
        print(f"Agent output: {output_text}")
        return None
    except Exception as e:
        print(f"Error with LangChain agent: {e}")
        import traceback
        traceback.print_exc()
        return None

AGENT_REFINE_PROMPT_TEMPLATE = """
You are a regex engineer with Python code execution.

Current patterns:
{regex_patterns}

FAILED to match these descriptions:
{failed_samples}

CRITICAL RULES - DO NOT IGNORE:
1. Create GENERIC patterns based on FORMAT/STRUCTURE, not specific values
2. DO NOT hardcode beneficiary names, account numbers, or IDs
3. Use character classes ([A-Z\\s]+, \\w+, [A-Z0-9]+) not literal names
4. Focus on DELIMITERS (-, /, :) and PREFIXES (NEFT, RTGS, IMPS, UPI)
5. Patterns must work for ANY beneficiary with the same transaction format

Use python_repl tool to:
1. Analyze the STRUCTURE of failed samples (not specific values)
2. Identify common patterns in FORMAT and DELIMITERS
3. Create/refine GENERIC patterns using character classes
4. Test that patterns extract names without hardcoding them
5. Verify patterns would work with different names in same format

Goal: Extract beneficiary name using re.match() with GENERIC capture groups.

Return ONLY JSON with generic patterns (no explanations):
{{"patterns": ["regex1", "regex2", ...]}}
"""

def refine_regex_with_langchain_agent(regex_patterns, failed_samples):
    """Refines regex patterns using LangChain agent with Python REPL."""
    
    try:
        print("\n" + "="*80)
        print("Activating LangChain Agent for Pattern Refinement")
        print("="*80)
        
        # Initialize LLM
        llm = ChatOpenAI(
            model="gpt-4o",
            temperature=0.1,
            api_key=os.getenv("OPENAI_API_KEY"),
            base_url="https://model.thevotum.com/v1"
        )
        
        # Create Python REPL tool
        python_repl = PythonREPLTool()
        tools = [python_repl]
        
        # Create prompt
        prompt = ChatPromptTemplate.from_messages([
            ("system", "You are an expert regex engineer. Create GENERIC patterns based on FORMAT and DELIMITERS, never hardcode specific names, IDs, or account numbers. Use character classes ([A-Z\\s]+, \\w+, etc.) for variable content. Patterns must work for ANY beneficiary with the same transaction structure."),
            ("human", "{input}"),
            ("placeholder", "{agent_scratchpad}"),
        ])
        
        # Create agent
        agent = create_tool_calling_agent(llm, tools, prompt)
        agent_executor = AgentExecutor(
            agent=agent,
            tools=tools,
            verbose=True,
            max_iterations=10,
            handle_parsing_errors=True
        )
        
        # Format input
        user_input = AGENT_REFINE_PROMPT_TEMPLATE.format(
            regex_patterns=json.dumps(regex_patterns, indent=2),
            failed_samples="\n".join(f"- {s}" for s in failed_samples)
        )
        
        # Run agent
        print("Agent is refining patterns...\n")
        result = agent_executor.invoke({"input": user_input})
        
        print("\n" + "="*80)
        print("Refinement Complete")
        print("="*80)
        
        output_text = result.get("output", "")
        print(f"\nAgent Output:\n{output_text}\n")
        
        # Extract JSON
        json_match = re.search(r'\{[^{}]*"patterns"[^{}]*\[.*?\][^{}]*\}', output_text, re.DOTALL)
        if json_match:
            data = json.loads(json_match.group(0))
        else:
            data = json.loads(output_text)
        
        if "patterns" in data and isinstance(data["patterns"], list):
            return data["patterns"]
        
        for key in data:
            if isinstance(data[key], list):
                return data[key]
        
        raise ValueError("No patterns array found in refinement output.")

    except json.JSONDecodeError as e:
        print(f"JSON parsing error: {e}")
        print(f"Agent output: {output_text}")
        return None
    except Exception as e:
        print(f"Error with LangChain refinement: {e}")
        import traceback
        traceback.print_exc()
        return None

def test_and_refine_regex(df, desc_col, regex_patterns):
    """Tests regex patterns against the full dataset and triggers refinement."""
    print("\n--- Testing Patterns Against Full Dataset ---")
    all_descriptions = df[desc_col].dropna().unique()
    failed_descriptions = []

    for desc in all_descriptions:
        if not isinstance(desc, str):
            continue
        
        matched = False
        for pattern in regex_patterns:
            try:
                if re.match(pattern, desc):
                    matched = True
                    break
            except re.error:
                continue
        
        if not matched:
            failed_descriptions.append(desc)

    total_unique = len(all_descriptions)
    failed_count = len(failed_descriptions)
    success_rate = ((total_unique - failed_count) / total_unique) * 100

    print(f"\nTest Results Before Refinement:")
    print(f"  - Total Unique Descriptions: {total_unique}")
    print(f"  - Matched: {total_unique - failed_count}")
    print(f"  - Failed: {failed_count}")
    print(f"  - Success Rate: {success_rate:.2f}%")

    if not failed_descriptions:
        print("\nSuccess! All unique descriptions matched a regex pattern.")
        return regex_patterns

    print(f"\nSample Failed Descriptions (showing first 5):")
    for desc in failed_descriptions[:5]:
        print(f"  - {desc}")

    samples_for_refinement = failed_descriptions[:20]
    refined_patterns = refine_regex_with_langchain_agent(regex_patterns, samples_for_refinement)
    
    if refined_patterns:
        print("\n--- Testing Refined Patterns ---")
        refined_failed = []
        
        for desc in all_descriptions:
            if not isinstance(desc, str):
                continue
            
            matched = False
            for pattern in refined_patterns:
                try:
                    if re.match(pattern, desc):
                        matched = True
                        break
                except re.error:
                    continue
            
            if not matched:
                refined_failed.append(desc)
        
        refined_failed_count = len(refined_failed)
        refined_success_rate = ((total_unique - refined_failed_count) / total_unique) * 100
        
        print(f"\nTest Results After Refinement:")
        print(f"  - Total Unique Descriptions: {total_unique}")
        print(f"  - Matched: {total_unique - refined_failed_count}")
        print(f"  - Failed: {refined_failed_count}")
        print(f"  - Success Rate: {refined_success_rate:.2f}%")
        print(f"\nImprovement: {refined_success_rate - success_rate:+.2f}% ({failed_count - refined_failed_count:+d} more matches)")
        
        if refined_failed and refined_failed_count < failed_count:
            print(f"\nRemaining Failed Descriptions (showing first 5):")
            for desc in refined_failed[:5]:
                print(f"  - {desc}")
    
    return refined_patterns

def main():
    """Main function to generate regex for bank statements."""
    parser = argparse.ArgumentParser(description="Generate regex for bank statements using OpenAI.")
    parser.add_argument("csv_file", help="Path to the bank statement CSV file.")
    parser.add_argument("--desc_col", default="description", help="Name of the transaction description column.")
    
    args = parser.parse_args()

    try:
        df = pd.read_csv(args.csv_file)
        
        if args.desc_col not in df.columns:
            raise ValueError(f"Column '{args.desc_col}' not found in the CSV file.")

        # Use single iterative agent that generates, tests, and refines until 90% accuracy
        regex_patterns = generate_regex_with_iterative_agent(df, args.desc_col)

        if regex_patterns:
            print("\n" + "="*80)
            print("Generated Regex Patterns")
            print("="*80)
            print(json.dumps(regex_patterns, indent=2))

            # Verify final results
            test_regex_patterns(df, args.desc_col, regex_patterns)
        else:
            print("\nFailed to generate regex patterns.")

    except (ValueError, FileNotFoundError) as e:
        print(f"Error: {e}")

if __name__ == "__main__":
    main()